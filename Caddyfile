# Freehold — one front door, HTTPS BY DEFAULT.
#
# Local dev uses Caddy's own internal CA (`tls internal`) on plain `localhost`,
# so there's no /etc/hosts editing and no mkcert install — Caddy mints the cert
# itself. Run `make trust` once to trust that CA in your browser (then the green
# padlock, and secure-context features like camera + PWA + service workers work).
#
# In production you swap `localhost` for your real domain and delete `tls internal`
# — Caddy fetches a real Let's Encrypt cert automatically. No config, no landlord.

localhost {
	tls internal

	# Keycloak: OIDC endpoints, its login theme resources, and the admin console
	handle /realms/* {
		reverse_proxy keycloak:8080
	}
	handle /resources/* {
		reverse_proxy keycloak:8080
	}
	handle /js/* {
		reverse_proxy keycloak:8080
	}
	handle /admin/* {
		reverse_proxy keycloak:8080
	}

	# Bound the request body at the front door. Starlette spools a multipart part
	# to disk while parsing, BEFORE any handler sees its size — so a 10 GB POST
	# fills the disk no matter how careful the app is. 12 MB leaves headroom over
	# the app's own 10 MiB upload cap for the multipart envelope.
	request_body {
		max_size 12MB
	}

	# Public media (avatars, banners) served from MinIO.
	# Scoped to the IMAGES bucket on purpose: a bare /media/* proxies ANY bucket,
	# so any future bucket is on the internet the moment it exists. Reports and
	# uploaded spreadsheets are served by the app, behind the login, instead.
	handle /media/freehold/* {
		uri strip_prefix /media
		reverse_proxy minio:9000
	}

	# The app (default)
	handle {
		reverse_proxy app:8000
	}
}
