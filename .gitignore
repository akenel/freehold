# python
__pycache__/
*.pyc
.venv/
# env / secrets — NEVER commit
.env
*.env
uat.env
# ...and anything derived from them. `*.env` only matches names ENDING in .env,
# so .env.bak / .env.prod / .env.pre-ollama.bak were all still committable.
.env.*
*.env.*
!.env.example
# data
*.db
*.sqlite3
# local scratch
scratchpad/
# generated at deploy time
app/build-sha.txt
# built public docs site (MkDocs output — regenerated by `make docs-build`)
site/
# encrypted db dumps (never commit backups)
backups/
# extracted local CA (generated by `make trust`)
freehold-local-ca.crt
# Keycloak file-vault secrets (SMTP password etc.) — written by ops/set-smtp.py
keycloak/vault/*
!keycloak/vault/.gitkeep
